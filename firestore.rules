rules_version = '2';

// SecureVote - corrected Firestore rules (review draft).
// Test in the Emulator Suite before any deployment.
//
// ASSUMPTIONS (please confirm or adjust):
//  - organizations.status in ['pending','verified','active','suspended','rejected']
//    and only 'verified'/'active' orgs may operate (see orgOperational).
//  - votingEvents.status uses UPPER-CASE values exactly as written by the Cloud Functions:
//    'DRAFT','SCHEDULED','ACTIVE','CLOSED','CANCELLED','ARCHIVED'.
//  - Eligibility lists and the frozen voter roll live in
//    votingEventEligibility/{eventId} (Owner/Admin read only), NOT on the
//    votingEvents document, so members cannot read rosters.
//  - rateLimits/{key_uid}, invitationRateLimit/{uid}, joinCodeRateLimit/{uid},
//    and joinCodeOrgThrottle/{organizationId} are all written only by Cloud
//    Functions (global deny applies to each - none has an explicit rule below).
//  - results/{eventId} has a boolean `published` field set by publishResults().
//  - turnout/{eventId} holds a counter document maintained by castVote().
//  - All organization membership/role/event/candidate/option writes go through
//    Cloud Functions (Admin SDK bypasses these rules).

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // AUTHENTICATION
    // =========================

    function signedIn() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return signedIn() && request.auth.token.platformAdmin == true;
    }

    function verifiedEmail() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    // =========================
    // MEMBERSHIP / ROLES
    // =========================

    function membershipPath(orgId, uid) {
      return /databases/$(database)/documents/organizationMembers/$(orgId + "_" + uid);
    }

    function isActiveMember(orgId) {
      return signedIn()
        && exists(membershipPath(orgId, request.auth.uid))
        && get(membershipPath(orgId, request.auth.uid)).data.organizationId == orgId
        && get(membershipPath(orgId, request.auth.uid)).data.userId == request.auth.uid
        && get(membershipPath(orgId, request.auth.uid)).data.status == "active";
    }

    function hasRole(orgId, role) {
      return isActiveMember(orgId)
        && get(membershipPath(orgId, request.auth.uid)).data.role == role;
    }

    function isOwner(orgId) {
      return hasRole(orgId, "owner");
    }

    function isOwnerOrAdmin(orgId) {
      return isOwner(orgId) || hasRole(orgId, "admin");
    }

    // Operational organizations include pending, verified, and active (suspended/rejected are blocked).
    function orgOperational(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)).data.status
        in ["pending", "verified", "active"];
    }

    // FIX: drafts are hidden from ordinary members (SRS 7.2).
    function canSeeEvent(orgId, eventStatus) {
      return isActiveMember(orgId)
        && orgOperational(orgId)
        && (
          isOwnerOrAdmin(orgId)
          || eventStatus != "DRAFT"
        );
    }

    // =========================
    // USERS
    // =========================

    // Public, non-sensitive update metadata. Console/Admin SDK only writes.
    // Clients cannot enumerate release documents or change update requirements.
    match /appReleases/{platform} {
      allow get: if platform in ['android', 'ios'];
      allow list, create, update, delete: if false;
    }

    match /users/{userId} {

      allow read: if signedIn() && request.auth.uid == userId;

      allow create: if false;   // created by the completeRegistration callable (Admin SDK)

      // FIX: field-level restriction (Rules spec section 47).
      // Only photoUrl is writable directly by the client (set right after
      // Google sign-in). displayName/firstName/lastName/phoneNumber have no
      // editing UI today and are NOT sanitized against control/bidi-spoofing
      // characters at the rules layer (rules can only bound size/type, not
      // strip characters) - route any future "edit profile" feature through
      // a Cloud Function using sanitizePlainText(), the same as every other
      // free-text field, rather than re-opening direct writes to them.
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["photoUrl"])
        && (request.resource.data.photoUrl == null
             || (request.resource.data.photoUrl is string
                 && request.resource.data.photoUrl.size() <= 500));

      allow delete: if false;
    }

    // =========================
    // ORGANIZATIONS
    // =========================

    match /organizations/{organizationId} {

      allow read: if isPlatformAdmin() || isActiveMember(organizationId);

      allow create: if false;

      // FIX: direct client writes removed entirely. Owners update name/
      // description/branding exclusively through the updateOrganization
      // Cloud Function, which the client already calls exclusively (never
      // writes this document directly) - that function sanitizes free text
      // (control/bidi-spoofing characters) and enforces the cross-collection
      // duplicate-name check, neither of which security rules can express
      // (rules can bound size/type but can't strip characters or run a
      // "does another org already use this name" query).
      allow update: if false;

      allow delete: if false;
    }

    // Daily member-count snapshots used by the "Members Growth" chart.
    // Written only by the snapshotMemberGrowth scheduled function.
    match /organizations/{organizationId}/memberGrowthSnapshots/{date} {
      allow read: if isPlatformAdmin() || isActiveMember(organizationId);
      allow create, update, delete: if false;
    }

    // Organization-shared event templates are accessed only through the
    // manageEventTemplates callable so role checks, field allowlists and audit
    // logging cannot be bypassed with direct client reads or writes.
    match /organizations/{organizationId}/eventTemplates/{templateId} {
      allow read, create, update, delete: if false;
    }

    // Minimal public projection for join flow / verification-status screen.
    // Written only by functions; contains no sensitive fields.
    match /organizationPublic/{organizationId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // =========================
    // MEMBERS
    // =========================

    match /organizationMembers/{membershipId} {

      // FIX: parentheses added; original mixed && and || without grouping.
      allow read: if signedIn()
        && (
          resource.data.userId == request.auth.uid
          || isOwnerOrAdmin(resource.data.organizationId)
        );

      allow create, update, delete: if false;
    }

    // =========================
    // INVITATIONS
    // =========================

    match /organizationInvitations/{invitationId} {

      // FIX: was `signedIn()` - leaked every invitation to every user.
      allow read: if signedIn()
        && (
          isOwnerOrAdmin(resource.data.organizationId)
          || (verifiedEmail()
              && resource.data.email == request.auth.token.email)
        );

      allow create, update, delete: if false;
    }

    // =========================
    // JOINING CODES
    // =========================

    match /joiningCodes/{codeId} {
      // Matrix says "Admin" may read; hashes are useless to clients, and
      // the code lifecycle is handled by functions, so keep fully closed.
      allow read: if signedIn() && isOwnerOrAdmin(resource.data.organizationId);
      allow create, update, delete: if false;
    }

    // =========================
    // DEPARTMENTS
    // =========================

    match /departments/{departmentId} {
      allow read: if isActiveMember(resource.data.organizationId)
        && orgOperational(resource.data.organizationId);
      allow create, update, delete: if false;   // via functions
    }

    // =========================
    // VOTING EVENTS
    // =========================

    match /nominationRounds/{roundId} {
      allow read: if isActiveMember(resource.data.organizationId) && orgOperational(resource.data.organizationId);
      allow write: if false;
    }
    match /electionApprovals/{approvalId} {
      allow read: if isOwnerOrAdmin(resource.data.organizationId) && orgOperational(resource.data.organizationId);
      allow write: if false;
    }
    match /communicationJobs/{jobId} {
      allow read: if isOwnerOrAdmin(resource.data.organizationId) && orgOperational(resource.data.organizationId);
      allow write: if false;
    }
    match /nominationApplications/{applicationId} {
      allow read: if signedIn() && isActiveMember(resource.data.organizationId)
        && orgOperational(resource.data.organizationId)
        && (resource.data.userId == request.auth.uid || isOwnerOrAdmin(resource.data.organizationId));
      allow write: if false;
    }
    match /votingEvents/{eventId} {
      allow read: if canSeeEvent(resource.data.organizationId, resource.data.status);
      allow create, update, delete: if false;   // via functions
    }

    // Eligibility lists: admin-only (members must not see rosters).
    match /votingEventEligibility/{eventId} {
      allow read: if isOwnerOrAdmin(resource.data.organizationId);
      allow create, update, delete: if false;
    }

    // =========================
    // CANDIDATES / POLL OPTIONS
    // =========================

    // Mirrors canSeeEvent for the parent votingEvent so a candidate/option can
    // never be read while its event is still DRAFT, regardless of whether the
    // caller knows the document ID directly or reaches it via a query.
    match /candidates/{candidateId} {
      allow read: if canSeeEvent(resource.data.organizationId,
        get(/databases/$(database)/documents/votingEvents/$(resource.data.votingEventId)).data.status);
      allow create, update, delete: if false;
    }

    match /pollOptions/{optionId} {
      allow read: if canSeeEvent(resource.data.organizationId,
        get(/databases/$(database)/documents/votingEvents/$(resource.data.votingEventId)).data.status);
      allow create, update, delete: if false;
    }

    // =========================
    // VOTES (never client accessible)
    // =========================

    match /votes/{voteId} {
      allow read, create, update, delete: if false;
    }

    // =========================
    // PARTICIPATION
    // =========================

    match /participation/{participationId} {

      // FIX: `resource` is null for non-existent docs, which made the
      // "have I voted?" check error out. Allow the null case so the client
      // gets a clean "not found".
      allow read: if signedIn()
        && (resource == null || resource.data.userId == request.auth.uid);

      allow create, update, delete: if false;
    }

    // =========================
    // RECEIPTS
    // =========================

    match /voteReceipts/{receiptId} {

      allow read: if signedIn()
        && (resource == null || resource.data.userId == request.auth.uid);

      allow create, update, delete: if false;
    }

    // =========================
    // TURNOUT COUNTERS (FIX: admins need a read path for monitoring)
    // =========================

    match /turnout/{eventId} {
      allow read: if isOwnerOrAdmin(resource.data.organizationId);
      allow create, update, delete: if false;
    }

    // =========================
    // RESULTS (eventResults collection)
    // =========================

    match /eventResults/{eventId} {

      // Before calculation, only the event's active Owner/Admin may observe
      // the missing-document state. Allowing every signed-in user to read a
      // missing result but denying an existing unpublished result reveals
      // whether calculation has happened.
      // Owners/Admins may review after closure; members only see published
      // results.
      allow read: if signedIn()
        && ((resource == null
             && exists(/databases/$(database)/documents/votingEvents/$(eventId))
             && isOwnerOrAdmin(get(/databases/$(database)/documents/votingEvents/$(eventId)).data.organizationId))
            || (resource != null
                && isOwnerOrAdmin(resource.data.organizationId))
            || (resource != null
                && isActiveMember(resource.data.organizationId)
                && resource.data.published == true));

      allow create, update, delete: if false;
    }

    // Legacy/unused path (no function or client code writes or reads this
    // collection - eventResults above is the real one), kept locked down
    // with the same missing-document restriction for defense in depth.
    match /results/{eventId} {
      allow read: if signedIn()
        && ((resource == null
             && exists(/databases/$(database)/documents/votingEvents/$(eventId))
             && isOwnerOrAdmin(get(/databases/$(database)/documents/votingEvents/$(eventId)).data.organizationId))
            || (resource != null
                && isOwnerOrAdmin(resource.data.organizationId))
            || (resource != null
                && isActiveMember(resource.data.organizationId)
                && resource.data.published == true));

      allow create, update, delete: if false;
    }

    // =========================
    // AUDIT LOGS & REPORTS
    // =========================

    match /auditLogs/{logId} {
      allow read: if isOwnerOrAdmin(resource.data.organizationId);
      allow create, update, delete: if false;
    }

    match /platformAuditLogs/{logId} {
      allow read: if isPlatformAdmin();
      allow create, update, delete: if false;
    }

    match /platformReports/{reportId} {
      allow read: if isPlatformAdmin();
      allow create, update, delete: if false;
    }

    match /userReports/{reportId} {
      // FIX: field-level restriction (Rules spec section 47, same pattern as
      // /users above) - a signed-in user could otherwise write arbitrary
      // extra fields/size into their own report document.
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.userId
        && request.resource.data.keys().hasOnly(
             ["userId", "userEmail", "category", "subject", "message",
              "receiptReference", "createdAt", "status"])
        && request.resource.data.userEmail is string
        && request.resource.data.userEmail.size() <= 320
        // Package D5: lets a report be filed as an election issue with an
        // optional receipt reference, reusing this same mechanism rather
        // than a separate dispute system.
        && request.resource.data.category in
             ["General feedback", "Election issue", "Technical problem", "Account issue"]
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && (!("receiptReference" in request.resource.data)
            || (request.resource.data.receiptReference is string
                && request.resource.data.receiptReference.size() <= 200))
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == "open";
      allow read: if isPlatformAdmin() || (signedIn() && request.auth.uid == resource.data.userId);
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      // Server-written only (e.g. remindNonVoters) - a client can never
      // create one for itself or anyone else. A recipient may read their
      // own and mark it read, nothing more.
      allow read: if signedIn() && request.auth.uid == resource.data.userId;
      allow update: if signedIn() && request.auth.uid == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false;
    }

    // =========================
    // INTERNAL RATE-LIMIT COUNTERS
    // =========================

    // _rateLimits/{keyPrefix_uid}: written exclusively by Cloud Functions via
    // the Admin SDK (which bypasses these rules). No client should ever read
    // or write these documents directly. The global deny below already covers
    // this collection; this explicit rule exists for documentation clarity.
    match /_rateLimits/{docId} {
      allow read, write: if false;
    }

    // Billing: Stripe ids and webhook de-duplication markers. Server-only
    // (Admin SDK); organizations/{id} itself is readable by every member, so
    // nothing billing-sensitive may live there. plan/planStatus on the org doc
    // are likewise unwritable by clients (organizations update is false).
    match /organizationBilling/{orgId} {
      allow read, write: if false;
    }
    match /stripeEvents/{eventId} {
      allow read, write: if false;
    }

    // =========================
    // GLOBAL DENY-BY-DEFAULT (FIX: was absent from the skeleton)
    // =========================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
