rules_version = '2';

// SecureVote - Storage rules (aligned with the Cloud Functions).
//
// Candidate photo path (exactly as used by createCandidate / finalizeCandidatePhoto):
//   organizations/{orgId}/events/{eventId}/candidates/{candidateId}/photo.jpg
//
// - Read:   Owner/Admin always; other ACTIVE members only after the event leaves DRAFT
//           (no public/token URLs are issued).
// - Write:  Owner/Admin of the organization, only while the event is DRAFT,
//           only to the fixed file name photo.jpg, image/jpeg, max 5 MB.
//           finalizeCandidatePhoto re-verifies size, content type and JPEG signature.
// - Delete: Owner/Admin (deletion by Cloud Functions uses the Admin SDK).
//
// Cross-service lookups (firestore.get/exists) require the Storage service agent
// to have Firestore access (Firebase does this automatically for the default setup).

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function memberPath(orgId) {
      return /databases/(default)/documents/organizationMembers/$(orgId + "_" + request.auth.uid);
    }

    function isActiveMember(orgId) {
      return signedIn()
        && firestore.exists(memberPath(orgId))
        && firestore.get(memberPath(orgId)).data.status == "active"
        && firestore.get(memberPath(orgId)).data.organizationId == orgId;
    }

    function isOwner(orgId) {
      return isActiveMember(orgId)
        && firestore.get(memberPath(orgId)).data.role == "owner";
    }

    function isOwnerOrAdmin(orgId) {
      return isActiveMember(orgId)
        && firestore.get(memberPath(orgId)).data.role in ["owner", "admin"];
    }

    function orgOperational(orgId) {
      return firestore.get(/databases/(default)/documents/organizations/$(orgId)).data.status
        in ["verified", "active"];
    }

    // Candidate photos belong to elections, which pending organizations may run
    // (same set as OPERATIONAL_ORG_STATUSES / the Firestore rules).
    function orgCanRunEvents(orgId) {
      return firestore.get(/databases/(default)/documents/organizations/$(orgId)).data.status
        in ["pending", "verified", "active"];
    }

    function eventIsDraft(orgId, eventId) {
      let ev = firestore.get(/databases/(default)/documents/votingEvents/$(eventId)).data;
      return ev.organizationId == orgId && ev.status == "DRAFT";
    }

    // Members may only see a candidate photo once the election is out of DRAFT,
    // mirroring the Firestore rule that hides draft candidates from members.
    function eventVisibleToMembers(orgId, eventId) {
      let ev = firestore.get(/databases/(default)/documents/votingEvents/$(eventId)).data;
      return ev.organizationId == orgId && ev.status != "DRAFT";
    }

    // The path must name a real candidate of THIS event; otherwise an admin could
    // park arbitrary 5 MB objects under invented candidate ids.
    function candidateBelongsToEvent(orgId, eventId, candidateId) {
      let c = firestore.get(/databases/(default)/documents/candidates/$(candidateId)).data;
      return c.organizationId == orgId && c.votingEventId == eventId;
    }

    function validJpeg() {
      return request.resource.contentType == "image/jpeg"
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024;
    }

    // ---- Candidate photographs ----
    match /organizations/{orgId}/events/{eventId}/candidates/{candidateId}/photo.jpg {
      allow read: if isOwnerOrAdmin(orgId)
        || (isActiveMember(orgId)
            && orgCanRunEvents(orgId)
            && eventVisibleToMembers(orgId, eventId));
      allow create, update: if isOwnerOrAdmin(orgId)
        && orgCanRunEvents(orgId)
        && eventIsDraft(orgId, eventId)
        && candidateBelongsToEvent(orgId, eventId, candidateId)
        && validJpeg();
      allow delete: if isOwnerOrAdmin(orgId);
    }

    // ---- User profile avatar (owner only writes; 500 KB, matches client-side limit) ----
    match /users/{uid}/profile/{fileName} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.size > 0
        && request.resource.size <= 500 * 1024;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // ---- Organization logo (Owner only manages branding; 2 MB) ----
    // Only the Owner may change the file: an Admin overwriting logo.png would
    // change what members see without going through the Owner-only
    // updateOrganization callable.
    match /organizations/{orgId}/logo/{fileName} {
      allow read: if isActiveMember(orgId);
      allow create, update: if isOwner(orgId)
        && orgOperational(orgId)
        && request.resource.contentType.matches('image/(png|jpeg|webp)')
        && request.resource.size > 0
        && request.resource.size <= 2 * 1024 * 1024;
      allow delete: if isOwner(orgId);
    }

    // ---- Deny everything else ----
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
